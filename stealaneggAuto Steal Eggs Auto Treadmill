-- PROXIMITY PROMPT TRIGGER HELPER (Handles HoldDuration & LineOfSight)
local function triggerProximityPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 99999
    end)
    
    -- Method 1: Executor built-in fireproximityprompt
    if fireproximityprompt then
        pcall(function() fireproximityprompt(prompt, 0) end)
        pcall(function() fireproximityprompt(prompt) end)
    end
    
    -- Method 2: Simulate InputHoldBegan / InputHoldEnded
    pcall(function()
        prompt:InputHoldBegan()
        task.wait(0.05)
        prompt:InputHoldEnded()
    end)
end

