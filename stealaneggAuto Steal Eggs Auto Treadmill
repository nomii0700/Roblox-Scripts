    end
})

SafetySection:CreateToggle({
    Name = "Noclip (Wall Pass)",
    Default = true,
    UsePurple = false,
    Callback = function(state)
        getgenv().NoclipSpeed = state
    end
})

-- SECTION 2: FARMING & AUTOMATION
local FarmSection = MainDashTab:CreateSection("Farming Mods")

FarmSection:CreateToggle({
    Name = "Auto Steal Eggs",
    UsePurple = false,
    Callback = function(state)
        getgenv().AutoSteal = state
        if state then
            -- Base Position save
            local baseCFrame = nil
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                baseCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
            end
            
            -- Safe Teleport Helper (Hovers 5 studs ABOVE egg + disables CanTouch)
            local function SafeGlideToTarget(targetCFrame)
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChildOfClass("Humanoid") then return false end
                if char:FindFirstChildOfClass("Humanoid").Health <= 0 then return false end
                
                -- Temporarily disable CanTouch on parts to bypass laser sensors
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanTouch = false
                        part.CanCollide = false
                    end
                end
                
                -- Hover 5 studs ABOVE egg so player never touches floor lasers
                local safeHoverCFrame = targetCFrame + Vector3.new(0, 5, 0)
                
                local dist = (char.HumanoidRootPart.Position - safeHoverCFrame.Position).Magnitude
                local duration = math.clamp(dist / 250, 0.15, 0.5)
                
                local tween = TweenService:Create(char.HumanoidRootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = safeHoverCFrame})
                tween:Play()
                tween.Completed:Wait()
                return true
            end

            task.spawn(function()
                while getgenv().AutoSteal do
                    task.wait(0.25)
                    pcall(function()
                        local char = LocalPlayer.Character
                        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                            if not baseCFrame then
                                baseCFrame = char.HumanoidRootPart.CFrame
                            end
                            
                            -- Scan workspace for eggs & prompts
                            for _, obj in pairs(workspace:GetDescendants()) do
                                if not getgenv().AutoSteal then break end
                                local isEgg = false
                                local prompt = nil

                                if obj:IsA("ProximityPrompt") and (string.find(obj.ActionText:lower(), "steal") or string.find(obj.ObjectText:lower(), "egg")) then
                                    prompt = obj
                                    isEgg = true
                                elseif (obj:IsA("Model") or obj:IsA("BasePart")) and string.find(obj.Name:lower(), "egg") and not obj:IsDescendantOf(char) then
                                    prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    isEgg = true
                                end

                                if isEgg then
                                    local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj or obj.Parent)
                                    if targetPart and targetPart:IsA("BasePart") then
                                        -- 1. Hover safely above Egg
                                        if SafeGlideToTarget(targetPart.CFrame) then
                                            task.wait(0.15)
                                            -- 2. Fire prompt without touching ground
                                            if prompt then
                                                fireproximityprompt(prompt, 0)
                                            elseif firetouchinterest then
                                                firetouchinterest(char.HumanoidRootPart, targetPart, 0)
                                                task.wait(0.05)
                                                firetouchinterest(char.HumanoidRootPart, targetPart, 1)
                                            end
                                            task.wait(0.2)
                                            -- 3. Return safely to Base
                                            SafeGlideToTarget(baseCFrame)
                                            task.wait(0.4)
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        end
    end
})

FarmSection:CreateToggle({
    Name = "Auto Treadmill",
    UsePurple = true,
    Callback = function(state)
        getgenv().AutoTreadmill = state
        if state then
            task.spawn(function()
                while getgenv().AutoTreadmill do
                    task.wait(0.4)
                    pcall(function()
                        local treadmillEvent = nil
                        for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                            if v:IsA("RemoteEvent") and string.find(v.Name:lower(), "treadmill") then
                                treadmillEvent = v
                                break
                            end
                        end
                        
                        if treadmillEvent then
                            treadmillEvent:FireServer()
                        else
                            for _, obj in pairs(workspace:GetDescendants()) do
                                if obj:IsA("BasePart") and string.find(obj.Name:lower(), "treadmill") then
                                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                        LocalPlayer.Character.HumanoidRootPart.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
                                        break
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        end
    end
})

