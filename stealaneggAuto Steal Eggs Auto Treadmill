if hookmetamethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod and getnamecallmethod() or "FireServer"
        if (method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer") and self then
            local remoteName = self.Name
            local remotePath = self:GetFullName()
            local args = {...}
            local argsFormatted = ""
            for i, v in ipairs(args) do
                argsFormatted = argsFormatted .. tostring(v) .. (i < #args and ", " or "")
            end
            task.spawn(function() logRemote(remoteName, remotePath, method, argsFormatted) end)
        end
        return oldNamecall(self, ...)
    end)
end

