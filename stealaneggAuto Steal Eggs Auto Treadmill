-- SECTION 4: VISUALS (ESP)
local VisualsSection = MainDashTab:CreateSection("Visuals (ESP)")

VisualsSection:CreateToggle({
    Name = "Highlight Egg ESP",
    UsePurple = true,
    Callback = function(state)
        getgenv().EggESP = state
        
        local function clearESP()
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Highlight") and v.Name == "NomiiEggESP" then
                    v:Destroy()
                end
            end
        end
        
        clearESP()
        
        if state then
            task.spawn(function()
                while getgenv().EggESP do
                    task.wait(1.5)
                    pcall(function()
                        for _, obj in pairs(workspace:GetDescendants()) do
                            if not getgenv().EggESP then break end
                            if (obj:IsA("Model") or obj:IsA("BasePart")) and not obj:IsDescendantOf(LocalPlayer.Character) then
                                local isEgg = string.find(obj.Name:lower(), "egg") or string.find(obj.Name:lower(), "nest")
                                if not isEgg then
                                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and (string.find(prompt.ActionText:lower(), "steal") or string.find(prompt.ObjectText:lower(), "egg")) then
                                        isEgg = true
                                    end
                                end

                                if isEgg then
                                    if not obj:FindFirstChild("NomiiEggESP") then
                                        local hl = Instance.new("Highlight")
                                        hl.Name = "NomiiEggESP"
                                        hl.Adornee = obj
                                        hl.FillColor = Color3.fromRGB(0, 229, 255)
                                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                        hl.FillTransparency = 0.35
                                        hl.OutlineTransparency = 0
                                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                        hl.Parent = obj
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        else
            clearESP()
        end
    end
})

